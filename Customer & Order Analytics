This project uses a SQLiteStudio/Letos database containing multiple related tables. The SQL query extracts and analyzes customer and order data to produce meaningful statistics.

--1. How many many unique orders were placed in January? In other words, how many distinct order ids do we have?
    SELECT COUNT(distinct orderID)
    FROM JanSales
    WHERE length(orderID) = 6
    AND orderID <> 'Order ID'
    ;
    -- Counts distinct January order IDs while filtering out invalid IDs and the column header.

--2. How many of those orders were for an iPhone?
    SELECT count(distinct orderID)
    FROM JanSales
    WHERE length(orderID) = 6
    AND orderID <> 'Order ID'
    AND Product = 'iPhone'
    ;
    -- Counts unique January orders containing an iPhone, excluding invalid order IDs and the column header.
    
--3. Select the customer account numbers for all the orders that were placed in February.
    SELECT distinct acctnum
    FROM customers
    JOIN FebSales
    ON customers.order_id = FebSales.orderID
    WHERE length(orderID) = 6
    AND orderID <> 'Order ID'
    ;
    -- Joins the customers and February sales tables using order IDs to retrieve unique customer account numbers associated with February orders.    

--4. Which product was the cheapest one sold in January, and what was the price?
    SELECT Product
    , MIN(price)
    FROM JanSales
    ;
    -- Uses the MIN() function to identify the lowest product price recorded in January.

--5. What is the total revenue for each product sold in January?
    SELECT Product
    , sum(quantity)*price as revenue
    FROM JanSales
    GROUP BY Product
    ;
    -- Groups January sales by product and calculates total revenue using quantity multiplied by price.

--6. Which products were sold in February at 548 Lincoln St, Seattle, WA 98101, how many of each were sold, and what was the total revenue?
    SELECT Product
    , location
    , SUM(Quantity)
    , SUM(Quantity)*price AS revenue
    FROM FebSales
    WHERE location = '548 Lincoln St, Seattle, WA 98101'
    GROUP BY Product
    ;
    -- Filters February sales by the specified location and calculates the total quantity sold and revenue for each product.

--7. How many customers ordered more than 2 products at a time in February, and what was the average amount spent for those customers?
    SELECT count(distinct customers.acctnum)
    , avg(Quantity*price)
    FROM FebSales
    LEFT JOIN customers
    ON FebSales.orderID = customers.order_id
    WHERE FebSales.Quantity >= 2
    AND length(orderid) = 6
    AND orderid <> 'Order ID'
    ;
    -- Joins February sales with customer records to count unique customers meeting the order quantity criteria and calculate the average spending value. 
