1. Who are the VIPs giving and receiving feedback from?

SELECT giver.member_id Person_Giving_Feedback_ID
, giver.last_name Giver_Last_Name
, giver.first_name Giver_First_name
, receiver.member_id Person_Receiving_Feedback_ID
, receiver.last_name Receiver_Last_Name
, receiver.first_name Receiver_First_Name
FROM vips giver
JOIN vips receiver
ON giver.provides_feedback_to = receiver.member_id
;
--Used a self join to find VIPs that are giving and receiving feedback from.

